# Copy to .env and fill in. .env is git-ignored; never commit real credentials.

# Which environment block from src/config/environments.ts to use:
# local | dev | beta | staging | prod
TEST_ENV=beta

# Target URLs.
#
# Set them here and they win over everything in src/config/environments.ts —
# including when you change TEST_ENV, which is the trap: with BASE_URL filled in,
# TEST_ENV=staging still runs against whatever is written below.
#
# Leave both blank to let TEST_ENV pick the URLs from the table instead. A new
# project can skip the table entirely and declare its URLs only here.
# API_URL defaults to BASE_URL when the API shares the origin.
BASE_URL=
API_URL=

# Tenant the login screen asks for before the username ("Mã doanh nghiệp")
COMPANY_CODE=

# Test accounts (must already exist in the target environment)
USER_USERNAME=
USER_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Pre-issued API token; leave blank if the API fixture logs in instead
API_TOKEN=

# How long a cached login session is reused before the UI login runs again
SESSION_TTL_MINUTES=30

# Show the browser window while tests run (1 = visible). Ignored in CI, which is
# always headless. A headed run also drops to a single worker so it stays watchable.
HEADED=
# Slow every action down by N milliseconds so a human can follow. Headed runs only.
SLOW_MO=

# Timeouts in milliseconds (optional)
ACTION_TIMEOUT=
NAVIGATION_TIMEOUT=
EXPECT_TIMEOUT=
TEST_TIMEOUT=

# debug | info | warn | error
LOG_LEVEL=info
