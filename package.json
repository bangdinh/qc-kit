{
  "name": "qc-kit",
  "version": "1.0.0",
  "description": "Bo kit QC dung chung — automation web/mobile/backend, moi du an ke thua thay vi copy khung",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:guest": "playwright test --project=chromium-guest",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --debug",
    "test:watch": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "report": "playwright show-report",
    "trace": "playwright show-trace",
    "codegen": "playwright codegen",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install --with-deps",
    "test:unit": "playwright test --project=unit",
    "verify": "npm run typecheck && npm run test:unit"
  },
  "keywords": [
    "playwright",
    "automation",
    "e2e",
    "testing"
  ],
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "typescript": "^5.6.0"
  }
}
