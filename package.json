{
  "name": "qc-kit",
  "version": "0.1.0",
  "description": "Bo kit QC dung chung — automation web/mobile/backend, moi du an ke thua thay vi copy khung",
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:guest": "playwright test --project=chromium-guest",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --debug",
    "test:watch": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "report": "playwright show-report",
    "trace": "playwright show-trace",
    "codegen": "playwright codegen",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install --with-deps",
    "test:unit": "playwright test --project=unit",
    "verify": "npm run typecheck && npm run build && npm run test:unit",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build"
  },
  "keywords": [
    "playwright",
    "automation",
    "e2e",
    "testing"
  ],
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "typescript": "^5.6.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "default": "./dist/contract/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures/index.d.ts",
      "default": "./dist/fixtures/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./package.json": "./package.json",
    "./scaffold": {
      "types": "./dist/scaffold/index.d.ts",
      "default": "./dist/scaffold/index.js"
    }
  },
  "files": [
    "dist",
    "cmd",
    "README.md",
    "ONBOARDING.md",
    "STRUCTURE.md",
    "CLAUDE.md",
    "docs"
  ],
  "peerDependencies": {
    "@playwright/test": ">=1.55.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "bin": {
    "qc-kit": "./cmd/scaffold/index.js"
  }
}
